{
  "name": "@teamtracker/desktop-admin",
  "version": "1.0.0",
  "description": "TeamTracker Admin desktop — embeds a local office server or opens a remote dashboard",
  "license": "MIT",
  "author": "TeamTracker <hamdymohamedak@users.noreply.github.com>",
  "homepage": "https://github.com/hamdymohamedak/TeamTracker",
  "type": "module",
  "electronVersion": "30.5.1",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "bundle:server": "node scripts/bundle-admin-server.mjs",
    "dev": "node scripts/ensure-electron.mjs && npm run build && TEAMTRACKER_EMBED_SERVER=0 electron .",
    "dev:local": "node scripts/ensure-electron.mjs && npm run bundle:server && npm run build && TEAMTRACKER_EMBED_SERVER=1 electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "predist": "node scripts/bundle-admin-server.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run bundle:server && npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run bundle:server && npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run bundle:server && npm run build && electron-builder --mac --x64 --publish never",
    "dist:win": "npm run bundle:server && npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run bundle:server && npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run bundle:server && npm run build && electron-builder -mwl --publish never"
  },
  "build": {
    "appId": "com.teamtracker.admin",
    "productName": "TeamTracker Admin",
    "executableName": "teamtracker-admin",
    "copyright": "Copyright © 2026 TeamTracker",
    "electronVersion": "30.5.1",
    "extraMetadata": {
      "name": "teamtracker-admin"
    },
    "artifactName": "TeamTracker-Admin-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "server-bundle",
        "to": "admin-server",
        "filter": ["**/*"]
      }
    ],
    "afterPack": "scripts/afterPack.cjs",
    "forceCodeSigning": false,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "dmg": {
      "title": "TeamTracker-Admin-${version}",
      "icon": "assets/icon.png",
      "writeUpdateInfo": false,
      "artifactName": "TeamTracker-Admin-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "signAndEditExecutable": true,
      "signingHashAlgorithms": ["sha256"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeamTracker Admin",
      "artifactName": "TeamTracker-Admin-Setup-${version}.${ext}"
    },
    "linux": {
      "category": "Office",
      "executableName": "teamtracker-admin",
      "maintainer": "TeamTracker <hamdymohamedak@users.noreply.github.com>",
      "vendor": "TeamTracker",
      "synopsis": "Admin dashboard desktop shell",
      "description": "TeamTracker Admin — desktop window for the admin dashboard, with Open Website in your browser.",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "TeamTracker Admin",
        "Comment": "TeamTracker admin dashboard",
        "Categories": "Office;Network;",
        "StartupNotify": "true",
        "Terminal": "false"
      }
    },
    "appImage": {
      "artifactName": "TeamTracker-Admin-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "teamtracker-admin-${version}-${arch}.${ext}",
      "packageCategory": "utils",
      "priority": "optional"
    },
    "publish": {
      "provider": "github",
      "owner": "hamdymohamedak",
      "repo": "TeamTracker",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.8"
  },
  "main": "dist/main.cjs"
}
