{
  "name": "teamtracker",
  "version": "1.0.0",
  "description": "TeamTracker — employee time tracking and admin dashboard",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "admin",
    "desktop",
    "desktop-admin",
    "shared"
  ],
  "scripts": {
    "dev:admin": "pnpm -C admin run dev",
    "dev:desktop": "pnpm -C desktop run dev",
    "dev:desktop-admin": "pnpm -C desktop-admin run dev",
    "build:admin": "pnpm -C admin run build",
    "build:desktop": "pnpm -C desktop run build",
    "build:desktop-admin": "pnpm -C desktop-admin run build",
    "typecheck:shared": "tsc --noEmit -p shared/tsconfig.json",
    "typecheck:admin": "pnpm -C admin run typecheck",
    "typecheck:desktop": "pnpm -C desktop exec tsc --noEmit",
    "typecheck:desktop-admin": "pnpm -C desktop-admin exec tsc --noEmit",
    "typecheck": "pnpm run typecheck:shared && pnpm run typecheck:admin && pnpm run typecheck:desktop && pnpm run typecheck:desktop-admin",
    "test": "pnpm -C admin run test",
    "test:conformance": "pnpm -C admin run test:conformance",
    "test-all": "pnpm run typecheck && pnpm run test && pnpm run build:desktop && pnpm run build:desktop-admin && pnpm run build:admin",
    "reset-password": "pnpm -C admin run reset-password",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
