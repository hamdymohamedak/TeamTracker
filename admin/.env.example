# TeamTracker Admin — Environment Variables

# =============================================================================
# REQUIRED (production)
# =============================================================================

# Strong secret used to sign dashboard + device JWTs (≥32 chars).
# Generate: openssl rand -hex 32
# Do NOT change after users/devices enroll — existing tokens become invalid.
JWT_SECRET=your_jwt_secret_here

# Runtime mode. Must be "production" on the VPS.
NODE_ENV=production

# HTTP listen port (nginx proxies here).
PORT=3001

# Persistent data root (production default on single-VPS installs).
DATA_DIR=/var/lib/teamtracker

# SQLite database file (keep under DATA_DIR; never under /opt/.../application).
DATABASE_PATH=/var/lib/teamtracker/database/admin.db

# Uploads root (org logos + screenshots).
UPLOADS_DIR=/var/lib/teamtracker/uploads

# Automated SQLite backup destination (VACUUM INTO scheduler).
BACKUPS_DIR=/var/lib/teamtracker/backups

# =============================================================================
# OPTIONAL
# =============================================================================

# Public URL of this instance (password-reset links, invites, employee downloads).
# Example: https://track.yourcompany.com
# PUBLIC_BASE_URL=https://track.yourcompany.com

# CORS allowlist. Leave unset for same-origin behind nginx.
# Use a specific origin in split frontends, or * to reflect any.
# CORS_ORIGIN=https://track.yourcompany.com

# Default screenshot file retention (days) when org setting is unset / fallback.
# Org Settings can still override per-organization retention in the UI.
# SCREENSHOT_RETENTION_DAYS=30

# --- Automated SQLite backups ---
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14

# --- Email (password reset, invites, daily summary) ---
# Prefer Resend OR SMTP (Resend tried first when RESEND_API_KEY is set).
# EMAIL_FROM=TeamTracker <noreply@yourdomain.com>
# RESEND_API_KEY=
# RESEND_FROM=TeamTracker <noreply@yourdomain.com>
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TeamTracker <noreply@yourdomain.com>
# SMTP_SECURE=0

# --- Genesis AI (optional LLM chat) ---
# DEEPSEEK_API_KEY=

# --- Development only ---
# Seed demo org/employees on boot. Never enable in production.
# SEED_DEMO_DATA=0

# --- Live View (WebRTC + binary WebSocket fallback) ---
# LIVE_VIEW_DEFAULT_QUALITY=auto
# LIVE_VIEW_MAX_FRAME_BYTES=220000
# Binary WS hard FPS caps (never raise for LAN smoothness through the VPS)
# LIVE_VIEW_MAX_FPS=4
# LIVE_VIEW_MIN_FPS=1
# LAN WebRTC P2P profile (high FPS stays off the VPS)
# LAN_LIVE_VIEW_MAX_FPS=30
# LAN_LIVE_VIEW_DEFAULT_FPS=12
# INTERNET_LIVE_VIEW_MAX_FPS=4
# TURN_LIVE_VIEW_MAX_FPS=4
# LIVE_VIEW_LAN_RTT_MAX_MS=40
# LIVE_VIEW_AUTO_UPGRADE_DELAY=20000
# LIVE_VIEW_AUTO_DOWNGRADE_THRESHOLD=1500
# LIVE_VIEW_AUTO_DOWNGRADE_COOLDOWN=3000
# LIVE_VIEW_WEBRTC_ENABLED=1
# LIVE_VIEW_WS_FALLBACK_ENABLED=1
# STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Prefer short-lived credentials (coturn static-auth-secret):
# TURN_SECRET=
# TURN_CREDENTIAL_TTL=3600
# Or static TURN user/pass:
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- WebSocket ---
# WS_HEARTBEAT_INTERVAL=30000

# --- Local / legacy development defaults (do not use on production VPS) ---
# DATA_DIR=./data
# DATABASE_PATH=./data/admin.db
# UPLOADS_DIR=./data/uploads
# BACKUPS_DIR=./data/backups
