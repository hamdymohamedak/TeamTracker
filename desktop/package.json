{
  "name": "@teamtracker/desktop",
  "version": "1.0.4",
  "description": "Desktop activity tracker for TeamTracker",
  "author": "TeamTracker <hamdymohamedak@users.noreply.github.com>",
  "type": "module",
  "electronVersion": "30.5.1",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/ensure-electron.mjs && tsc && vite build && electron .",
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run build && electron-builder -mwl --publish never",
    "release": "npm run build && electron-builder -mwl --publish always"
  },
  "build": {
    "appId": "com.teamtracker.tracker",
    "productName": "TeamTracker",
    "copyright": "Copyright \u00a9 2026 TeamTracker",
    "electronVersion": "30.5.1",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "TeamTracker captures periodic screenshots so your team admin can review work activity.",
        "NSAppleEventsUsageDescription": "TeamTracker reads the active window title to track which apps are in use.",
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "TeamTracker ${version}",
      "icon": "assets/icon.png",
      "background": null,
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeamTracker"
    },
    "linux": {
      "category": "Utility",
      "maintainer": "TeamTracker <hamdymohamedak@users.noreply.github.com>",
      "vendor": "TeamTracker",
      "synopsis": "Employee activity tracker",
      "description": "TeamTracker desktop tracker \u2014 samples the active window and syncs productivity data to your admin dashboard.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "TeamTracker",
        "Comment": "TeamTracker activity tracker",
        "Categories": "Utility;Office;",
        "StartupNotify": "false",
        "Terminal": "false"
      },
      "executableArgs": []
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ],
      "packageCategory": "utils",
      "priority": "optional"
    },
    "publish": {
      "provider": "github",
      "owner": "hamdymohamedak",
      "repo": "TeamTracker",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "electron-store": "^8.2.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "main": "dist/main.cjs"
}
